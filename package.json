{
  "name": "fernreach",
  "version": "0.1.0",
  "private": true,
  "description": "Fernreach: a cozy side-scrolling browser adventure with simple peer-to-peer multiplayer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "phaser": "^4.2.1",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/don-tay/fernreach.git"
  },
  "homepage": "https://don-tay.github.io/fernreach/"
}
